# ─────────────────────────────────────────────────────────────────
# @reachbell/sdk  ·  .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────────
/node_modules

# ── Build output (shipped to npm via package.json `files`, not git) ─
/dist

# ── Environment variables ────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Testing & coverage ───────────────────────────────────────────
/coverage

# ── Logs ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── TS build cache ───────────────────────────────────────────────
*.tsbuildinfo
